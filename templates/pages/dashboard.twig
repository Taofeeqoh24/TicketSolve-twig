{% extends 'base.twig' %}

{% block header %}
<header class="flex justify-around items-center p-2 mt-3 rounded-3xl shadow-md mx-auto bg-[#f6fafd]">
  <h2>Ticket<span class='font-bold text-purple-800'>Solve</span></h2>
  <div class="flex">
    <button id="logoutBtn"
      class="px-6 py-2 bg-purple-500 text-white rounded-3xl text-sm font-bold">
      Logout
    </button>
  </div>
</header>
{% endblock %}

{% block content %}
<div class="flex m-2">
  <aside class="rounded-sm p-2 w-2/5 md:w-1/5 lg:w-1/5 bg-purple-800 h-screen">
    <h2 class="p-4 font-bold text-2xl text-white">Ticket</h2>

    <nav>
      <ul class="flex flex-col p-4 gap-4 text-white font-bold">
        <li class="hover:bg-purple-500 hover:p-2 cursor-pointer" id="tab-dashboard">Dashboard</li>
        <li class="hover:bg-purple-500 hover:p-2 cursor-pointer" id="tab-tickets">Create Ticket</li>
        <li class="hover:bg-purple-500 hover:p-2 cursor-pointer" id="tab-my-tickets">My Tickets</li>
      </ul>
    </nav>
  </aside>

  <main id="mainContent" class="lg:p-4 lg:w-4/5 w-3/5 text-purple-500 font-bold shadow-md rounded-sm bg-white">
    <h5 class="text-center mt-2">
      Dashboard
    </h5>
    <h4 class="text-sm mt-4 p-6">
      Ticket Summary
    </h4>
    <div class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-3 p-6">
      <div class="summary-box bg-[#16A34A]">
        <h2 class="summary-header">
          TOTAL TICKETS
        </h2>
        <p id="totalTickets" class="text-4xl">
          0
        </p>
      </div>
      <div class="summary-box bg-[#F59E0B]">
        <h2 class="summary-header">
          OPEN TICKETS
        </h2>
        <p id="openTickets" class="text-4xl">
          0
        </p>
      </div>
      <div class="summary-box bg-[#6B7280]">
        <h2 class="summary-header">
          RESOLVED TICKETS
        </h2>
        <p id="closedTickets" class="text-4xl">
          0
        </p>
      </div>
    </div>
  </main>
</div>
<script src="/public/js/dashboard.js"></script>
{% endblock %}
